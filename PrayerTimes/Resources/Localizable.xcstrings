    },
    "Nothing leaves your Mac — the location is used only to compute times.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يغادر جهاز Mac — يُستخدم الموقع فقط لحساب الأوقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই আপনার Mac ছাড়ে না — অবস্থান শুধু সময় হিসাব করতে ব্যবহৃত হয়।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey Mac'inizden çıkmaz — konum yalnızca vakitleri hesaplamak için kullanılır."
          }
        }
      }
    },
    "Enable prayer notifications": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل إشعارات الصلاة"
          }
        },
        "bn": {
