          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş doğuşu ve aralıklar için vakti izle"
          }
        }
      }
    },
    "Keep astronomical times for non-jamaat events.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالأوقات الفلكية للأحداث غير الجماعية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ-জামাত ইভেন্টের জন্য জ্যোতির্বৈজ্ঞানিক সময় রাখুন।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cemaat dışı olaylar için astronomik vakitleri koru."
          }
        }
      }
    },
    "Jamaat schedule": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جدول الجماعة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জামাতের সময়সূচি"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cemaat programı"
          }
        }
      }
    },
    "Enter the times your mosque announces. The Adhan reminder fires the minutes above before each.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الأوقات التي يعلنها مسجدك. ينطلق تذكير الأذان بالدقائق أعلاه قبل كل وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মসজিদ যে সময় ঘোষণা করে তা লিখুন। উপরের মিনিট অনুযায়ী প্রতিটির আগে আজানের রিমাইন্ডার বাজবে।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminizin duyurduğu vakitleri girin. Ezan hatırlatıcısı her birinden yukarıdaki dakika kadar önce çalar."
          }
        }
      }
    },
