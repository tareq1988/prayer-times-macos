            "value": "%1$@-এর আগে পড়ুন (সূর্যোদয় %2$@)।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ öncesinde kılın (gün doğumu %2$@)."
          }
        }
      }
    },
    "Pray before %@, makruh after that (sunset %@).": {
