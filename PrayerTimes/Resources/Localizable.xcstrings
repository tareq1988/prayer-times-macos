            "value": "Adım %1$lld / %2$lld"
          }
        }
      }
    },
    "Where are you?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين أنت؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কোথায়?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredesiniz?"
          }
        }
      }
    },
    "So we compute the right times for your place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنحسب الأوقات الصحيحة لمكانك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাতে আমরা আপনার স্থানের সঠিক সময় হিসাব করতে পারি।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerinize doğru vakitleri hesaplayalım diye."
          }
        }
      }
    },
    "How should we calculate?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف نحسب الأوقات؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা কীভাবে হিসাব করব?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl hesaplayalım?"
          }
        }
      }
    },
    "Pick a method and your Asr madhab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر طريقة الحساب ومذهب العصر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি পদ্ধতি ও আপনার আসরের মাযহাব বেছে নিন।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yöntem ve Asr mezhebinizi seçin."
          }
        }
      }
    },
    "Stay on time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على وقتك"
          }
