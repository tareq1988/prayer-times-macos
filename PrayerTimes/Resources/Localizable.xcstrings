    "Islamic midnight": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منتصف الليل الشرعي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
