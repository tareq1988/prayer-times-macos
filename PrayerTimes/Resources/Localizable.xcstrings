    "Master switch for all prayer alerts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح الرئيسي لجميع تنبيهات الصلاة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্ত নামাজ অ্যালার্টের প্রধান সুইচ।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm namaz uyarıları için ana anahtar."
          }
        }
      }
    },
    "Applied to every prayer. Expand a prayer below to override its sound, reminder, or iqamah.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق على كل صلاة. وسّع صلاةً أدناه لتجاوز صوتها أو تذكيرها أو إقامتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি নামাজে প্রযোজ্য। কোনো নামাজের শব্দ, রিমাইন্ডার বা ইকামত ওভাররাইড করতে নিচে সেটি প্রসারিত করুন।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her namaza uygulanır. Sesini, hatırlatmasını veya kametini değiştirmek için aşağıda bir namazı genişletin."
          }
        }
      }
    },
