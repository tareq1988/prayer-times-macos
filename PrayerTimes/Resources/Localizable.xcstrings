    "Grant location access": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول إلى الموقع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অ্যাক্সেসের অনুমতি দিন"
