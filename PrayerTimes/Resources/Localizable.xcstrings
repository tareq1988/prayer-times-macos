          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey hazır"
          }
        }
      }
    },
    "Change any of this anytime from the menu-bar item → Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر أيًّا من ذلك في أي وقت من عنصر شريط القوائم ← الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেনু-বার আইটেম → সেটিংস থেকে যেকোনো সময় এর যেকোনো কিছু পরিবর্তন করুন।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunların herhangi birini istediğiniz zaman menü çubuğu öğesi → Ayarlar'dan değiştirin."
          }
        }
      }
    },
